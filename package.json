{
  "name": "api-typeorm",
  "private": true,
  "version": "0.0.0",
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p test/tsconfig.json",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/migration-data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/migration-data-source.ts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/migration-data-source.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/migration-data-source.ts",
    "tokens:purge": "ts-node src/scripts/purge-refresh-tokens.ts",
    "tokens:purge:prod": "node dist/scripts/purge-refresh-tokens.js",
    "deliveries:dispatch": "ts-node src/scripts/dispatch-deliveries.ts",
    "deliveries:dispatch:prod": "node dist/scripts/dispatch-deliveries.js",
    "migration:run:prod": "typeorm migration:run -d dist/migration-data-source.js",
    "test": "node --no-experimental-strip-types --require ts-node/register/transpile-only --test \"test/unit/**/*.test.ts\"",
    "test:integration": "node --no-experimental-strip-types --require ts-node/register/transpile-only --test --test-concurrency=1 \"test/integration/**/*.test.ts\"",
    "migration:check": "typeorm-ts-node-commonjs migration:generate --check -d src/migration-data-source.ts src/migrations/DriftCheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/jwt": "^10.2.1",
    "@fastify/rate-limit": "^10.3.0",
    "bcrypt": "6.0.0",
    "class-validator": "^0.14.1",
    "dotenv": "^16.0.3",
    "fastify": "^5.12.6",
    "fastify-plugin": "^5.0.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcrypt": "5.0.0",
    "@types/node": "^20.19.43",
    "@types/validator": "^13.15.10",
    "eslint": "^9.39.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  },
  "main": "index.js",
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "description": "",
  "engines": {
    "node": "^22.13.0 || >=24.11.0"
  }
}
